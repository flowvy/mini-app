# Public HTTPS hostname without scheme or path. The reverse proxy forwards it to 127.0.0.1:8001.
APP_DOMAIN=mini-app.example.com
APP_PORT=8001

# Telegram bot and Mini App.
BOT_TOKEN=0000000000:replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_openssl_output
ADMIN_TELEGRAM_IDS=123456789

# Local PostgreSQL password used only by this Compose project.
POSTGRES_PASSWORD=replace_with_openssl_output

# Remnawave panel API and webhook contract.
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=replace_with_remnawave_api_token
# Must equal WEBHOOK_SECRET_HEADER configured in Remnawave.
REMNAWAVE_WEBHOOK_SECRET=replace_with_existing_remnawave_webhook_secret

# Optional Uptime Kuma private origin allowlist, comma-separated.
KUMA_ALLOWED_PRIVATE_ORIGINS=

# Optional Beszel Pulse credentials and private origin allowlist.
BESZEL_EMAIL=
BESZEL_PASSWORD=
BESZEL_ALLOWED_PRIVATE_ORIGINS=

# Optional Tribute integration.
TRIBUTE_API_KEY=

# Optional Cloudflare R2 support attachments. Set all four values together or leave all blank.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
