# ── Telegram Bot ──
# Bot token from @BotFather
BOT_TOKEN=
# Public URL for Telegram webhook (your domain + /webhook)
WEBHOOK_URL=https://your-domain.com/webhook
# Public URL for Mini App frontend
WEBAPP_URL=https://your-domain.com
# Comma-separated Telegram IDs with admin access
ADMIN_TELEGRAM_IDS=123456789,987654321

# ── Database ──
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://flowvy:flowvy_dev@localhost:5432/flowvy

# ── Redis ──
# Redis connection string
REDIS_URL=redis://localhost:6379/0

# ── Remnawave ──
# Remnawave panel URL (your panel domain with https)
REMNAWAVE_URL=https://your-remnawave-panel.com
# Remnawave API token (generate in panel: Settings → API Tokens)
REMNAWAVE_API_TOKEN=
# HMAC-SHA256 secret for Remnawave webhook signature verification (optional)
REMNAWAVE_WEBHOOK_SECRET=

# ── Metrics ──
# Background metrics snapshot interval in seconds (default: 600)
METRICS_SNAPSHOT_INTERVAL_SECONDS=600

# ── Auth ──
# Telegram initData TTL in seconds (default: 86400 = 24h)
INIT_DATA_TTL=86400

# ── Debug ──
# Debug mode (true = CORS *, verbose logging; disable in production)
DEBUG=false
