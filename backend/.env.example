# Telegram bot token from @BotFather
BOT_TOKEN=
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://flowvy:flowvy@localhost:5432/flowvy
# Redis connection string
REDIS_URL=redis://localhost:6379/0
# Public URL for Telegram webhook (your domain + /webhook)
WEBHOOK_URL=
# Public URL for Mini App frontend
WEBAPP_URL=
# Remnawave panel URL (your panel domain with https)
REMNAWAVE_URL=
# Remnawave API token (generate in panel: Settings → API Tokens)
REMNAWAVE_API_TOKEN=
# Support page URL (shown to users in Mini App, optional)
SUPPORT_URL=
# Subscription renewal URL (shown to users in Mini App, optional)
RENEW_URL=
# Debug mode (true = CORS *, verbose logging; disable in production)
DEBUG=true
