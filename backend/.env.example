# ── Telegram Bot ──
# Keep empty in local/mock development. Production must provide a real BotFather token.
BOT_TOKEN=
# Leave webhook empty for local/mock development. Public mode requires a real
# BOT_TOKEN, an HTTPS WEBHOOK_URL, and a random TELEGRAM_WEBHOOK_SECRET.
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Local Mini App frontend URL
WEBAPP_URL=http://localhost:5173
# JSON array of Telegram IDs with admin access
ADMIN_TELEGRAM_IDS=[]

# ── Database ──
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://flowvy:flowvy_dev@localhost:5432/flowvy

# ── Redis ──
# Redis connection string
REDIS_URL=redis://localhost:6379/0

# ── Remnawave ──
# Remnawave panel URL (your panel domain with https)
REMNAWAVE_URL=
# Remnawave API token (generate in panel: Settings → API Tokens)
REMNAWAVE_API_TOKEN=
# HMAC-SHA256 secret from Remnawave WEBHOOK_SECRET_HEADER (32+ alphanumeric chars)
REMNAWAVE_WEBHOOK_SECRET=
# Reject deliveries older than 5 minutes or more than 30 seconds in the future.
REMNAWAVE_WEBHOOK_MAX_AGE_SECONDS=300
REMNAWAVE_WEBHOOK_FUTURE_TOLERANCE_SECONDS=30
# Bound request memory and retain only event metadata for 30 days.
REMNAWAVE_WEBHOOK_MAX_BODY_BYTES=262144
REMNAWAVE_WEBHOOK_RETENTION_DAYS=30
REMNAWAVE_WEBHOOK_CLEANUP_INTERVAL_SECONDS=21600
REMNAWAVE_WEBHOOK_CLEANUP_BATCH_SIZE=1000

# ── Uptime Kuma ──
# Public targets must use HTTPS. To use a Docker/LAN Kuma instance, explicitly
# allow its exact origin (scheme + host + port); wildcard and CIDR are unsupported.
KUMA_ALLOWED_PRIVATE_ORIGINS=
# Maximum accepted JSON response size from each public status-page endpoint.
KUMA_MAX_RESPONSE_BYTES=1048576

# ── Beszel ──
# Use a dedicated read-only Beszel user. Credentials stay server-side and are
# never returned by the admin API or stored in provider_settings.
BESZEL_EMAIL=
BESZEL_PASSWORD=
# Public targets must use HTTPS. Docker/LAN origins require an exact allow-list
# entry (scheme + host + port); wildcard and CIDR entries are unsupported.
BESZEL_ALLOWED_PRIVATE_ORIGINS=
# Maximum accepted JSON response size for each PocketBase API response.
BESZEL_MAX_RESPONSE_BYTES=1048576

# ── Tribute ──
# Generate in Tribute Creator Dashboard → Settings → API Keys. The secret stays
# server-side and is never returned to the Mini App.
TRIBUTE_API_KEY=
# Maximum accepted JSON response size for the read-only products API check.
TRIBUTE_MAX_RESPONSE_BYTES=1048576
# Observe-only webhook receiver: accept the documented ~24h retry window plus
# one hour of delivery tolerance, bound request memory, and retain metadata only.
TRIBUTE_WEBHOOK_MAX_AGE_SECONDS=90000
TRIBUTE_WEBHOOK_FUTURE_TOLERANCE_SECONDS=300
TRIBUTE_WEBHOOK_MAX_BODY_BYTES=65536
TRIBUTE_WEBHOOK_RETENTION_DAYS=90
# Durable provider delivery runs whenever the application is running. Anonymous or ambiguous
# payments remain review-only; these values only tune the worker's bounded retry loop.
TRIBUTE_ENTITLEMENT_WORKER_INTERVAL_SECONDS=10
TRIBUTE_ENTITLEMENT_LEASE_SECONDS=120
TRIBUTE_ENTITLEMENT_MAX_ATTEMPTS=5
# A redirect is only a pending local hand-off; payment still requires a signed webhook.
SPONSOR_CHECKOUT_PENDING_MINUTES=30

# ── Support attachments (optional Cloudflare R2) ──
# Leave all four R2 values empty to keep text Support available while attachments are disabled.
# Use one private Standard-class bucket and a bucket-scoped Object Read & Write token. Never enable
# r2.dev/public access. The fixed S3 endpoint is derived from R2_ACCOUNT_ID by the backend.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Server-authoritative limits: 50 MiB per file, 100 MiB total and five files per message.
SUPPORT_ATTACHMENT_MAX_FILE_BYTES=52428800
SUPPORT_ATTACHMENT_MAX_TOTAL_BYTES=104857600
# Signed upload URLs are short-lived; unattached upload intents are cleaned after one hour.
SUPPORT_UPLOAD_URL_TTL_SECONDS=600
SUPPORT_PENDING_UPLOAD_TTL_SECONDS=3600
# Attachments are removed three days after Resolve; whole requests expire after 90 days of inactivity.
SUPPORT_ATTACHMENT_RETENTION_DAYS=3
SUPPORT_REQUEST_RETENTION_DAYS=90
SUPPORT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
SUPPORT_RETENTION_CLEANUP_BATCH_SIZE=100

# ── Metrics ──
# Background metrics snapshot interval in seconds (default: 600)
METRICS_SNAPSHOT_INTERVAL_SECONDS=600

# ── Auth ──
# Telegram initData TTL in seconds (default: 86400 = 24h)
INIT_DATA_TTL=86400

# ── Debug ──
# Debug mode (true = CORS *, verbose logging; disable in production)
DEBUG=false
