# Backend API base URL
VITE_API_URL=/api
# Mock auth with role=ADMIN for local UI dev without Telegram (true/false)
VITE_MOCK_AUTH=
# Telegram ID to fetch real Remnawave data in mock auth mode (optional)
VITE_DEBUG_TELEGRAM_ID=
# Show empty devices list in mock auth mode (true/false, optional)
VITE_DEBUG_DEVICES_EMPTY=
