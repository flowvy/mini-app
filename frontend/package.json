{
	"name": "flowvy-frontend",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@11.24.0",
	"type": "module",
	"engines": {
		"node": ">=24.19.0 <25",
		"pnpm": ">=11.24.0 <12"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --project=mobile-chromium",
		"test:e2e:all": "playwright test --project=mobile-chromium --project=small-mobile-chromium --project=desktop-chromium && pnpm test:e2e:webkit",
		"test:e2e:webkit": "node scripts/run-webkit-e2e.mjs",
		"test:e2e:live": "playwright test --config=playwright.live.config.ts",
		"test:e2e:ui": "playwright test --ui --project=mobile-chromium",
		"test:e2e:update": "playwright test --update-snapshots",
		"verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@floating-ui/dom": "1.8.0",
		"@tanstack/react-query": "5.102.4",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-virtual": "3.14.10",
		"@tma.js/sdk-react": "3.0.23",
		"@tiptap/extension-character-count": "3.30.3",
		"@tiptap/extension-placeholder": "3.30.3",
		"@tiptap/markdown": "3.30.3",
		"@tiptap/pm": "3.30.3",
		"@tiptap/react": "3.30.3",
		"@tiptap/starter-kit": "3.30.3",
		"@zumer/snapdom": "2.24.10",
		"i18next": "26.4.0",
		"lucide-react": "1.34.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-i18next": "17.0.12",
		"react-markdown": "10.1.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.10",
		"@playwright/test": "1.62.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@typescript/typescript6": "6.0.2",
		"@vitejs/plugin-react": "6.1.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
