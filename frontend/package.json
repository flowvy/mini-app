{
	"name": "flowvy-frontend",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@10.33.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --project=mobile-chromium",
		"test:e2e:all": "playwright test",
		"test:e2e:live": "playwright test --config=playwright.live.config.ts",
		"test:e2e:ui": "playwright test --ui --project=mobile-chromium",
		"test:e2e:update": "playwright test --update-snapshots",
		"verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.96.2",
		"@tanstack/react-router": "^1.168.10",
		"@tanstack/react-virtual": "^3.13.23",
		"@telegram-apps/sdk-react": "^3.0.0",
		"@zumer/snapdom": "2.24.1",
		"geist": "^1.7.0",
		"i18next": "^26.0.3",
		"i18next-resources-to-backend": "^1.2.1",
		"lucide-react": "^1.7.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-i18next": "^17.0.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@biomejs/biome": "^1.9.0",
		"@playwright/test": "1.59.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	}
}
